<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="MapSpike.MainPage"
             Title="Térkép spike">

    <Grid>

        <mapsui:MapControl x:Name="MapView" />

        <!-- 1. kritérium: kötelező OSM attribúció -->
        <Label x:Name="AttributionLabel"
               Text="© OpenStreetMap contributors"
               FontSize="11"
               Padding="6,3"
               BackgroundColor="#B0FFFFFF"
               TextColor="#222222"
               HorizontalOptions="End"
               VerticalOptions="End"
               Margin="0,0,0,4" />

        <!-- 2. kritérium: a vetítés ellenőrzése látható legyen -->
        <Border x:Name="StatusPanel"
                Stroke="Transparent"
                BackgroundColor="#C0000000"
                Padding="10,6"
                Margin="8"
                HorizontalOptions="Start"
                VerticalOptions="Start">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label x:Name="StatusLabel"
                   Text="Betöltés..."
                   FontSize="12"
                   TextColor="White" />
        </Border>

        <!-- 6. kritérium: sötét mód kapcsoló -->
        <Button x:Name="DarkModeButton"
                Text="Sötét mód"
                FontSize="12"
                Padding="12,4"
                Margin="8"
                CornerRadius="8"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Clicked="OnDarkModeToggled" />

        <!-- 4. kritérium: markerre koppintva megnyíló részletpanel -->
        <Border x:Name="DetailPanel"
                IsVisible="False"
                Stroke="#33000000"
                BackgroundColor="White"
                Padding="16"
                Margin="12,0,12,28"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="4">
                <Label x:Name="DetailTitle"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#111111" />
                <Label x:Name="DetailBody"
                       FontSize="13"
                       TextColor="#444444" />
                <Button Text="Bezár"
                        FontSize="12"
                        Padding="10,2"
                        Margin="0,8,0,0"
                        HorizontalOptions="Start"
                        Clicked="OnCloseDetail" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
