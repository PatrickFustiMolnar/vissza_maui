<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:controls="clr-namespace:Vissza.Maui.Controls"
        x:Class="Vissza.Maui.Controls.OfferCardView"
        x:Name="Root"
        Style="{StaticResource CardBorder}"
        Margin="16,0,16,12">

    <!--
        Egy felajánlás listaeleme, a régi OfferCard.js leképezése.
        A BindingContext egy OfferDto; a levezetett szövegeket (címkék,
        becsült érték) a code-behind számolja, hogy a XAML olvasható maradjon.
    -->

    <Border.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTapped" />
    </Border.GestureRecognizers>

    <VerticalStackLayout Spacing="8">

        <Grid ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Spacing="6">
                <controls:BadgeView Kind="{Binding BottleTypeKind, Source={x:Reference Root}}"
                                    Text="{Binding BottleTypeLabel, Source={x:Reference Root}}" />
                <controls:BadgeView Kind="{Binding StatusKind, Source={x:Reference Root}}"
                                    Text="{Binding StatusLabel, Source={x:Reference Root}}"
                                    IsVisible="{Binding ShowStatus, Source={x:Reference Root}}" />
            </HorizontalStackLayout>

            <Label Grid.Column="1"
                   Text="›"
                   FontSize="22"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </Grid>

        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
            <Label Text="{Binding Offer.Quantity, Source={x:Reference Root}}"
                   FontSize="{StaticResource FontSizeHeading}"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
            <Label Text="db palack"
                   VerticalOptions="End"
                   Margin="0,0,0,3"
                   Style="{StaticResource SecondaryLabel}" />
        </HorizontalStackLayout>

        <Label Text="{Binding Offer.Address, Source={x:Reference Root}}"
               LineBreakMode="TailTruncation"
               MaxLines="1"
               Style="{StaticResource SecondaryLabel}" />

        <HorizontalStackLayout Spacing="6"
                               IsVisible="{Binding HasDonor, Source={x:Reference Root}}">
            <Label Text="{Binding Offer.DonorName, Source={x:Reference Root}}"
                   Style="{StaticResource SecondaryLabel}" />
            <Label Text="{Binding DonorRatingText, Source={x:Reference Root}}"
                   IsVisible="{Binding HasDonorRating, Source={x:Reference Root}}"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextColor="{StaticResource StarGold}" />
        </HorizontalStackLayout>

        <Label Text="{Binding CollectorText, Source={x:Reference Root}}"
               IsVisible="{Binding ShowCollector, Source={x:Reference Root}}"
               FontSize="{StaticResource FontSizeCaption}"
               TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />

        <Label Text="{Binding Offer.OtherDescription, Source={x:Reference Root}}"
               IsVisible="{Binding ShowOtherDescription, Source={x:Reference Root}}"
               Style="{StaticResource SecondaryLabel}" />

        <BoxView HeightRequest="1"
                 Margin="0,4"
                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Becsült érték" Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding EstimatedValueText, Source={x:Reference Root}}"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryStrongLight}, Dark={StaticResource PrimaryStrongDark}}" />
        </Grid>

    </VerticalStackLayout>

</Border>
