<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Vissza.Maui.Controls"
             xmlns:dtos="clr-namespace:Vissza.Shared.Dtos;assembly=Vissza.Shared"
             xmlns:res="clr-namespace:Vissza.Maui.Resources"
             xmlns:vm="clr-namespace:Vissza.Maui.ViewModels"
             x:Class="Vissza.Maui.Pages.CollectPage"
             x:DataType="vm:CollectViewModel"
             Title="Gyűjtés">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Alcím és összesítés, ahogy a régi képernyő fejlécében. -->
        <VerticalStackLayout Padding="16,8,16,0" Spacing="10">
            <Label Text="Találd meg a közeli felajánlásokat"
                   Style="{StaticResource SecondaryLabel}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{x:Static res:Icons.Leaf}" Style="{StaticResource IconLabel}" />
                        <Label Text="{Binding CollectedText}" Style="{StaticResource StatNumber}" />
                        <Label Text="Összegyűjtött" Style="{StaticResource StatLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{x:Static res:Icons.Cash}" Style="{StaticResource IconLabel}" />
                        <Label Text="{Binding EarnedText}" Style="{StaticResource StatNumber}" />
                        <Label Text="Ft becsült" Style="{StaticResource StatLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{x:Static res:Icons.Recycle}"
                               Style="{StaticResource IconLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource InfoLight}, Dark={StaticResource InfoDark}}" />
                        <Label Text="{Binding Co2Text}"
                               Style="{StaticResource StatNumber}"
                               TextColor="{AppThemeBinding Light={StaticResource InfoLight}, Dark={StaticResource InfoDark}}" />
                        <Label Text="kg CO₂" Style="{StaticResource StatLabel}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!--
            Nézetváltó. A régi appban ez három ikonos gomb volt: elérhető
            felajánlások, folyamatban lévő átvételek, lezártak.
        -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Padding="16,10,16,0" ColumnSpacing="8">
            <Button Text="Elérhető"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="0"
                    ContentLayout="Top,2"
                    Style="{StaticResource ViewTab}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Icons" Glyph="{x:Static res:Icons.Gift}" Size="20"
                                     Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </Button.ImageSource>
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAvailableView}" Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PrimarySubtleLight}, Dark={StaticResource PrimarySubtleDark}}" />
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Grid.Column="1"
                    Text="Folyamatban"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="1"
                    ContentLayout="Top,2"
                    Style="{StaticResource ViewTab}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Icons" Glyph="{x:Static res:Icons.Clock}" Size="20"
                                     Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </Button.ImageSource>
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPendingView}" Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PrimarySubtleLight}, Dark={StaticResource PrimarySubtleDark}}" />
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Grid.Column="2"
                    Text="Lezárt"
                    Command="{Binding SelectViewCommand}"
                    CommandParameter="2"
                    ContentLayout="Top,2"
                    Style="{StaticResource ViewTab}">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Icons" Glyph="{x:Static res:Icons.CheckCircleOutline}" Size="20"
                                     Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </Button.ImageSource>
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsCompletedView}" Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PrimarySubtleLight}, Dark={StaticResource PrimarySubtleDark}}" />
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Térkép: csak az elérhető felajánlásokhoz van értelme. -->
        <controls:VisszaMapView Grid.Row="2"
                                x:Name="MapView"
                                HeightRequest="200"
                                IsVisible="{Binding ShowSearchTools}" />

        <!-- Szűrők -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorder}"
                IsVisible="{Binding ShowSearchTools}"
                Margin="12,8"
                Padding="12">
            <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Palacktípus" Style="{StaticResource SecondaryLabel}" />
                        <Picker ItemsSource="{Binding BottleTypeOptions}"
                                SelectedIndex="{Binding SelectedBottleTypeIndex}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Rendezés" Style="{StaticResource SecondaryLabel}" />
                        <Picker ItemsSource="{Binding SortOptions}"
                                SelectedIndex="{Binding SelectedSortIndex}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Legalább" Style="{StaticResource SecondaryLabel}" />
                        <Entry Placeholder="Min. db" Text="{Binding MinQuantity}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Távolság (km)" Style="{StaticResource SecondaryLabel}" />
                        <Entry Placeholder="Max. km" Text="{Binding MaxDistanceKm}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            Text="Szűrés"
                            Command="{Binding ApplyFiltersCommand}"
                            VerticalOptions="End"
                            Padding="14,8"
                            FontSize="{StaticResource FontSizeBody}" />
                </Grid>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                       FontSize="{StaticResource FontSizeCaption}" />
            </VerticalStackLayout>
        </Border>

        <!-- Elérhető felajánlások -->
        <RefreshView Grid.Row="4"
                     IsVisible="{Binding ShowSearchTools}"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Offers}">

                <CollectionView.EmptyView>
                    <Label Text="{Binding BindingContext.EmptyText, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                           Margin="16"
                           HorizontalOptions="Center"
                           Style="{StaticResource SecondaryLabel}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:OfferDto">
                        <VerticalStackLayout>
                            <controls:OfferCardView Offer="{Binding .}"
                                                    TapCommand="{Binding BindingContext.SelectCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />

                            <Button Text="Részletek"
                                    Command="{Binding BindingContext.OpenDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                                    HorizontalOptions="Start"
                                    Margin="16,0,16,12"
                                    Padding="12,6"
                                    FontSize="{StaticResource FontSizeCaption}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- A saját átvételeim: folyamatban vagy lezárva -->
        <RefreshView Grid.Row="4"
                     IsVisible="{Binding ShowSearchTools, Converter={StaticResource Not}}"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Pickups}">

                <CollectionView.EmptyView>
                    <Label Text="{Binding BindingContext.EmptyText, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                           Margin="16"
                           HorizontalOptions="Center"
                           Style="{StaticResource SecondaryLabel}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PickupItem">
                        <Border Style="{StaticResource CardBorder}" Margin="16,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenPickupCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <controls:BadgeView Kind="{Binding StatusKind}" Text="{Binding StatusBadge}" />
                                    <Label Grid.Column="2"
                                           Text="{x:Static res:Icons.ChevronRight}"
                                           Style="{StaticResource MutedIconLabel}" />
                                </Grid>

                                <Label Text="{Binding Title}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontAttributes="Bold" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Label Text="{x:Static res:Icons.MapMarker}"
                                           Style="{StaticResource MutedIconLabel}"
                                           FontSize="16" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Location}"
                                           VerticalOptions="Center"
                                           Style="{StaticResource SecondaryLabel}" />
                                </Grid>

                                <Label Text="{Binding StatusText}" Style="{StaticResource SecondaryLabel}" />

                                <BoxView HeightRequest="1"
                                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding CreatedAtText}" Style="{StaticResource SecondaryLabel}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding EstimatedValueText}"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- Jelentkezés a kiválasztott felajánlásra -->
        <Border Grid.RowSpan="5"
                Style="{StaticResource CardBorder}"
                IsVisible="{Binding HasSelection}"
                Margin="16"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="12">
                <Label Text="Érdekel ez a felajánlás" FontAttributes="Bold"
                       FontSize="{StaticResource FontSizeSubtitle}" />

                <Label Text="{Binding SelectedOffer.Address}" Style="{StaticResource SecondaryLabel}" />

                <Entry Placeholder="Üzenet a felajánlónak (nem kötelező)"
                       Text="{Binding RequestMessage}" />

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                       FontSize="{StaticResource FontSizeCaption}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Mégsem"
                            Command="{Binding CancelSelectionCommand}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <Button Grid.Column="1"
                            Text="Érdeklődés küldése"
                            Command="{Binding SendRequestCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
