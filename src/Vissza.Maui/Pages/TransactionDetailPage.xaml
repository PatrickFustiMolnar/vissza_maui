<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vissza.Maui.ViewModels"
             x:Class="Vissza.Maui.Pages.TransactionDetailPage"
             x:DataType="vm:TransactionDetailViewModel"
             Title="Átvétel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding StatusText}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           FontAttributes="Bold" />

                    <Label Text="{Binding SummaryText}" Style="{StaticResource SecondaryLabel}" />

                    <BoxView HeightRequest="1"
                             Margin="0,4"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label Text="{Binding ConfirmationText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Partner" Style="{StaticResource SecondaryLabel}" />
                    <Label Text="{Binding PartnerName}" FontAttributes="Bold" />

                    <Button Text="Üzenet küldése"
                            Command="{Binding OpenChatCommand}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                            HorizontalOptions="Start"
                            Padding="14,8"
                            FontSize="{StaticResource FontSizeBody}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                   FontSize="{StaticResource FontSizeCaption}" />

            <Button Text="Megerősítem az átvételt"
                    Command="{Binding ConfirmCommand}"
                    IsVisible="{Binding CanConfirm}" />

            <Label Text="Megerősítetted. A lezáráshoz a másik fél megerősítése is kell."
                   IsVisible="{Binding IConfirmed}"
                   Style="{StaticResource SecondaryLabel}" />

            <Button Text="Átvétel lezárása"
                    Command="{Binding CompleteCommand}"
                    IsVisible="{Binding CanComplete}" />

            <Button Text="Partner értékelése"
                    Command="{Binding RateCommand}"
                    IsVisible="{Binding IsCompleted}" />

            <Button Text="Átvétel visszavonása"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding CanCancel}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
