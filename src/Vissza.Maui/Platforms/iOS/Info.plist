<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- A profilkép választásához. iOS ezeket a szövegeket szó szerint mutatja
	     a jogosultsági kérdésben, ezért magyarul és konkrétan fogalmaznak. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>A profilképed kiválasztásához férünk hozzá a fotóidhoz.</string>
	<key>NSCameraUsageDescription</key>
	<string>A profilképed elkészítéséhez használjuk a kamerát.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Fejlesztéshez: a helyi gépen futó API http-n megy. Élesben az
		     api.fustimolnarpatrick.com HTTPS, ez a kivétel csak a localhostra
		     és a helyi hálózatra vonatkozik, nem oldja fel az ATS-t. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
